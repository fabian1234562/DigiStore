# ═══════════════════════════════════════════════════
# DIGISTORE - CONFIGURACIÓN COMPLETA
# ═══════════════════════════════════════════════════
# Copia como .env.local y llena los valores
# En Vercel: Settings > Environment Variables
# ═══════════════════════════════════════════════════

# ── PASARELA DE PAGOS (MercadoPago) - OBLIGATORIO ──
# Registro: https://www.mercadopago.com.co
# Ve a Tu Negocio > Configuración > Credenciales
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui
MERCADOPAGO_MODE=sandbox

# ── URL DEL SITIO ──
NEXT_PUBLIC_BASE_URL=https://digi-store-cxss.vercel.app

# ═══════════════════════════════════════════════════════
# PROVEEDORES DE PRODUCTOS
# Configura los que puedas. MÁS PROVEEDORES = MÁS GANANCIA
# El sistema compara precios y siempre compra del más barato.
# ═══════════════════════════════════════════════════════

# ── PROVEEDOR 1: RELOADLY (fácil de registrar, gratis) ──
# Registro: https://www.reloadly.com
# Dashboard > Developers > API Settings
RELOADLY_CLIENT_ID=tu_client_id_aqui
RELOADLY_CLIENT_SECRET=tu_client_secret_aqui

# ── PROVEEDOR 2: FOXRELOAD (mejor para gift cards y gaming) ──
# Registro: https://foxreload.com
# Descuentos: 8-15% (mejor que Reloadly)
# Fortalezas: Steam, PlayStation, Xbox, Nintendo, gaming
FOXRELOAD_API_KEY=tu_api_key_aqui
FOXRELOAD_API_SECRET=tu_api_secret_aqui

# ── PROVEEDOR 3: FAZERCARDS (mayor variedad, 10,000+ productos) ──
# Registro: https://reseller.fazercards.com
# Descuentos: 5-15% con volumen
# Fortalezas: Variedad enorme de gift cards y suscripciones
FAZERCARDS_API_KEY=tu_api_key_aqui

# ── PROVEEDOR 4: XSOLLA (el MEJOR para gaming, 10-20% descuento) ──
# Registro: https://xsolla.com/for/resellers
# Descuentos: 10-20% en V-Bucks, Robux, PUBG, etc.
# Fortalezas: Gaming puro (Fortnite, Roblox, PUBG, EA FC...)
XSOLLA_MERCHANT_ID=tu_merchant_id_aqui
XSOLLA_API_KEY=tu_api_key_aqui

# ═══════════════════════════════════════════════════════
# CONFIGURACIÓN DE PRECIOS (en /src/lib/pricing.ts)
# ═══════════════════════════════════════════════════════
# DISCOUNT_FACTOR=0.92  (92% del descuento es tuyo, 8% se lo das al cliente)
# MIN_PROFIT_USD=0.30   (ganancia mínima $0.30 USD por venta)
# USD_TO_COP=3990        (tasa de cambio, actualizar cuando cambie)
