# ═══════════════════════════════════════════════════
# DIGISTORE - CONFIGURACIÓN
# ═══════════════════════════════════════════════════
# Copia este archivo como .env.local y llena los valores
#
# En Vercel: Settings > Environment Variables
# En local: crea .env.local en la raíz del proyecto
# ═══════════════════════════════════════════════════

# ── PROVEEDOR DE PRODUCTOS (Reloadly) ──
# Registro gratis: https://www.reloadly.com
# 1. Crea cuenta en reloadly.com
# 2. Ve a Dashboard > Developers > API Settings
# 3. Copia Client ID y Client Secret
RELOADLY_CLIENT_ID=tu_client_id_aqui
RELOADLY_CLIENT_SECRET=tu_client_secret_aqui

# ── PASARELA DE PAGOS (MercadoPago) ──
# Registro gratis: https://www.mercadopago.com.co
# 1. Crea cuenta en mercadopago.com.co
# 2. Ve a Tu Negocio > Configuración > Credenciales
# 3. Copia el Access Token de Producción
# 4. Para pruebas, usa el de Sandbox
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui

# Modo sandbox (true para pruebas, false para produccion)
MERCADOPAGO_MODE=sandbox

# ── URL DEL SITIO (para webhooks y redirecciones) ──
# En Vercel se configura automáticamente
# En local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://digi-store-cxss.vercel.app

# ── MÁRGENES DE GANANCIA ──
# (Opcional - si no se configuran, se usan los por defecto)
# Formato: categoria=margen (en decimal, 0.15 = 15%)
# MARKUP_GAMING=0.18
# MARKUP_GIFTCARDS=0.12
# MARKUP_STREAMING=0.15
# MARKUP_SUBSCRIPTIONS=0.20
# MARKUP_SOFTWARE=0.22